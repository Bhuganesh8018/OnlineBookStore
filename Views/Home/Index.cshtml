@model IEnumerable<OnlineBookStore.Models.Book>

<div class="row mb-3">
    <div class="col-md-8">
        <form method="get" class="d-flex">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control me-2" placeholder="Search by title or author" />
            <select name="category" class="form-select me-2" style="max-width:200px;">
                <option value="">All Categories</option>
                @foreach (var c in (IEnumerable<string>)ViewBag.Categories)
                {
                    <option value="@c" selected="@(ViewBag.SelectedCategory == c ? "selected" : null)">@c</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text text-muted">@item.Author</p>
                    <p class="card-text"><strong>₹@item.Price</strong></p>
                    <div class="mt-auto">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Add to Cart</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
