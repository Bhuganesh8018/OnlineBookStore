@model OnlineBookStore.Models.Book

<div class="row">
    <div class="col-md-4">
        <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.Title" />
    </div>
    <div class="col-md-8">
        <h2>@Model.Title</h2>
        <p class="text-muted">by @Model.Author</p>
        <p><strong>Category:</strong> @Model.Category</p>
        <p>@Model.Description</p>
        <p class="h4 text-success">₹@Model.Price</p>

        <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Id" class="btn btn-primary">Add to Cart</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
