@model IEnumerable<OnlineBookStore.Models.CartItem>

<h2>Your Cart</h2>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Book</th>
                <th>Price (₹)</th>
                <th>Quantity</th>
                <th>Total (₹)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @{
            decimal grandTotal = 0;
        }
        @foreach (var item in Model)
        {
            var total = item.Price * item.Quantity;
            grandTotal += total;
            <tr>
                <td>@item.Title</td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td>@total</td>
                <td>
                    <a asp-action="Remove" asp-route-id="@item.BookId" class="btn btn-sm btn-danger">Remove</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <h4>Grand Total: ₹@grandTotal</h4>
    <a asp-action="Clear" class="btn btn-warning">Clear Cart</a>
}
